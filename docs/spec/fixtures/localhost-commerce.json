  "simulations": [
    {
      "case": "prepaid-success-duplicate",
      "adapter": "payment",
      "sequence": [
        "pending",
        "confirmed",
        "same_confirmation_replayed"
      ],
      "expected": "Exactly one economic receipt and Purchase; reload returns the same order and payment attempt."
    },
    {
      "case": "payment-timeout-after-commit",
      "adapter": "payment",
      "sequence": [
        "provider_effect_committed",
        "response_timeout",
        "status_lookup_confirmed"
      ],
      "expected": "Look up the original operation identity; no second charge."
    },
    {
      "case": "late-payment-stock-loss",
      "adapter": "payment",
      "sequence": [
        "expired_reservation",
        "stock_unavailable",
        "late_confirmation"
      ],
      "expected": "Reconcile the original receipt; reacquire stock or execute a guarded refund without silent fulfillment."
    },
    {
      "case": "split-cod-refusal",
      "adapter": "shipping",
      "sequence": [
        "parcel_a_collected",
        "parcel_b_refused",
        "settlement_later"
      ],
      "expected": "One IDR99000 merchandise purchase; refusal and later company settlement create no new Purchase."
    },
    {
      "case": "last-component-race",
      "adapter": "inventory",
      "sequence": [
        "two_offers_share_last_unit",
        "simultaneous_reservations"
      ],
      "expected": "Real PostgreSQL race test permits exactly one reservation without overselling."
    },
    {
      "case": "label-funding-pending",
      "adapter": "shipping",
      "sequence": [
        "shipping_funding_unpaid",
        "no_valid_awb"
      ],
      "expected": "Printing is blocked with a reason; no blank PDF or new booking."
    },
    {
      "case": "label-expired-reprint",
      "adapter": "label",
      "sequence": [
        "artifact_ready",
        "download_expired",
        "safe_retrieval",
        "reprint"
      ],
      "expected": "Reuse the same active AWB; no charge or handover; TEST watermark remains."
    },
    {
      "case": "ads-consent-denied",
      "adapter": "advertising",
      "sequence": [
        "choice_denied",
        "verified_receipt"
      ],
      "expected": "Internal money truth is preserved; every vendor dispatch is suppressed."
    },
    {
      "case": "ads-delivery-timeout",
      "adapter": "advertising",
      "sequence": [
        "eligible",
        "accepted_response_lost",
        "retry_same_id"
      ],
      "expected": "One internal purchase instance; same retry identity; simulated acceptance is not attribution."
    },
    {
      "case": "chat-unknown-send",
      "adapter": "chat",
      "sequence": [
        "durable_commit",
        "response_lost",
        "same_message_retry",
        "reconnect"
      ],
      "expected": "One durable public message; scoped history and no staff-note leakage."
    },
    {
      "case": "shared-device-and-guest-link",
      "adapter": "identity",
      "sequence": [
        "buyer_a_logout",
        "buyer_b_login",
        "cross_order_link_attempt"
      ],
      "expected": "No private draft or history leakage; unauthorized guest-order linking is denied."
    },
    {
      "case": "replacement-affiliate-hold",
      "adapter": "affiliate",
      "sequence": [
        "original_received",
        "one_quantity_replaced",
        "replacement_received",
        "advance_clock"
      ],
      "expected": "Only affected quantity H+10 resets; inclusive IDR99000 threshold; no automatic external transfer."
    },
    {
      "case": "worker-crash-catchup",
      "adapter": "jobs",
      "sequence": [
        "event_committed",
        "worker_stopped",
        "worker_restart"
      ],
      "expected": "Durable catch-up preserves original identities; the order remains available."
    },
    {
      "case": "holiday-calendar-boundaries",
      "adapter": "clock",
      "sequence": [
        "explicit_test_policy",
        "synthetic_closure",
        "advance_clock"
      ],
      "expected": "Explicit test-only cutoff/Sunday rules and synthetic closures; not an authoritative national calendar."
    }
  ],
  "inventory_snapshot_basis": "Illustrative current inventory; historical order snapshots do not represent current reservations."
